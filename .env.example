# Private bootstrap configuration only. Keep .env.production mode 0600, never commit live values.
YUFLIX_DATABASE_URL=postgres://yuflix:REPLACE_ME@db.example.com:5432/yuflix?sslmode=verify-full

# Explicit origins, without trailing slashes. May include both schemes.
YUFLIX_ALLOWED_ORIGINS=https://stream.example.com,http://192.0.2.10:62471

# Opt-in: HTTP login transmits passwords and session cookies without transport encryption.
# Enable only on networks you fully trust. Defaults to false.
YUFLIX_ALLOW_INSECURE_HTTP=false

# The legacy YUFLIX_PUBLIC_ORIGIN=https://stream.example.com is still supported.
# Trusting X-Forwarded-Proto is set internally by Compose for its isolated Caddy gateway.
