FROM golang:1.27.3-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /yuflix-egress ./cmd/yuflix-egress
FROM alpine:3.23
RUN apk add --no-cache ca-certificates && addgroup -S app && adduser -S -G app app
COPY --from=builder /yuflix-egress /usr/local/bin/yuflix-egress
USER app
EXPOSE 62582
ENTRYPOINT ["/usr/local/bin/yuflix-egress"]
